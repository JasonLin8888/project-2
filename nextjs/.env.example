# Copy to .env.local and fill in. Restart `pnpm dev` after editing; this file is read at startup.
# With nothing set, the docs work and /dictate still saves recordings to ../_media/dictation/.

# Dictation: an audio model transcribes each recording, then a text model cleans it up into a note.
OPENROUTER_API_KEY=
# Any OpenRouter model that accepts audio input.
TRANSCRIBE_MODEL=google/gemini-3.8-flash
# Any OpenRouter text model.
CLEANUP_MODEL=anthropic/claude-sonnet-5.5
